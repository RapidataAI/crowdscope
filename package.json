{
  "name": "nextjs-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" --names \"frontend,backend\" --prefix-colors \"blue,green\"",
    "dev:frontend": "next dev --turbopack",
    "dev:backend": "cd api && nix develop -c python app.py",
    "build": "next build --turbopack",
    "start": "next start",
    "prod": "concurrently \"npm run prod:frontend\" \"npm run prod:backend\" --names \"frontend,backend\" --prefix-colors \"blue,green\"",
    "prod:frontend": "npm run build && next start",
    "prod:backend": "cd api && nix develop -c sh -c 'pip install gunicorn && gunicorn -w 4 -b 0.0.0.0:5328 index:app'",
    "flask": "cd api && FLASK_APP=app.py nix develop -c flask",
    "lint": "eslint"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.8",
    "@tanstack/react-query-devtools": "^5.62.8",
    "next": "15.5.0",
    "oidc-client-ts": "^3.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-oidc-context": "^3.3.0",
    "recharts": "^3.1.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
